# 专门为Vite使用的环境变量配置文件，Vite启动自动加载。
# 以VITE_ 开头的会暴露到浏览器端，以process.env 开头的会暴露到Node.js 端。 其他的只能Vite自己使用
# 前端vue中使用：import.meta.env.VITE_APP_TITLE （import.meta.env 是浏览器环境的API）
# vite.config.ts 配置文件中使用：env.VITE_API_BASE_URL （必须用 loadEnv() 手动加载）
# .env.local > env.[mode].local > .env.development > .env
VITE_APP_TITLE=agentfe
VITE_PAGE_SIZE=10
VITE_REQUEST_TIMEOUT=5000
VITE_API_BASE_URL=/api